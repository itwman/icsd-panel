# Copy to .env and edit:  cp .env.example .env

# Domain of the panel (an A record must point to this server).
ICSD_DOMAIN=panel.example.com
# The address agents and browsers use. Must be https.
ICSD_PUBLIC_URL=https://panel.example.com

# Every account must turn on 2FA before it can do anything (recommended: 1).
ICSD_REQUIRE_2FA=1
# Seconds between agent samples (2–60).
ICSD_SAMPLE_INTERVAL=5
